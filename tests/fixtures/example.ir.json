          "array": false,
          "optional": true
        }
      ],
      "source": "SELECT count(*) AS total FROM {movie}\nWHERE release_year > ?since:int=1995 AND title ILIKE ?q:string=\"%\"",
      "description": "Movie count under the same ?since / ?q filters the list uses.",
      "namespace": "movie",
      "result": {
        "kind": "object",
