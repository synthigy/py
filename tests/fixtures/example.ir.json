          "array": false,
          "optional": true
        }
      ],
      "source": "movie (release_year > ?since:int=1980, limit ?limit:int=20, offset ?offset:int=0, order by release_year desc)\n  xid\n  title (ilike ?q:string=\"%\")\n  release_year\n  _count\n    ratings:movie_ratings\n    actors:actors\n  _agg\n    ratings:movie_ratings\n      value: avg\n  ->genres\n    xid\n    name",
      "description": "Movies newest-first with rating/actor counts, average rating and genres.\nFilter by title with ?q (ilike) and minimum release year with ?since.",
      "watch": true,
      "result": {
        "kind": "object",
        "fields": [
          {
            "key": "xid",
            "type": "string",
            "nullable": false
          },
          {
