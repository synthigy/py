      "source": "music_album (plays > ?min_plays:int=-1, limit ?limit:int=20, offset ?offset:int=0, order by ?sort(plays, title, created_on)=\"plays desc\")\n  xid\n  title (ilike ?q:string=\"%\")\n  blurb\n  plays\n  cover\n  _count\n    tracks:tracks\n    artists:artists\n  ->artists\n    xid\n    name",
      "description": "Albums ranked by plays, with track/artist counts and\nartist chips. Filter by title with ?q (ilike).",
      "watch": true,
