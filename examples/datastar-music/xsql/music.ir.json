    {
      "description": "Library headline numbers for the dashboard.",
      "name": "stats",
      "params": [],
      "op": "sql-template",
      "source": "-- One CTE per entity, not scalar subqueries: RLS guards are injected per\n-- CTE scope, so each aggregate is scoped to what the caller may read.\nWITH al AS (SELECT count(*) AS n, sum({music_album.plays}) AS plays FROM {music_album}),\n     tr AS (SELECT count(*) AS n FROM {music_track}),\n     ar AS (SELECT count(*) AS n FROM {music_artist})\nSELECT al.n     AS total_albums,\n       tr.n     AS total_tracks,\n       al.plays AS total_plays,\n       ar.n     AS total_artists\nFROM al, tr, ar",
      "result": {
        "kind": "object",
        "fields": [
          {
            "key": "total_albums",
            "type": "int",
            "nullable": false
          },
          {
            "key": "total_tracks",
            "type": "int",
            "nullable": false
          },
          {
            "key": "total_plays",
            "type": "int"
          },
          {
            "key": "total_artists",
            "type": "int",
            "nullable": false
          }
        ]
      },
      "watch": [
        "music_album",
        "music_track",
        "music_artist"
      ],
      "entity": null,
      "namespace": "dashboard"
    },
