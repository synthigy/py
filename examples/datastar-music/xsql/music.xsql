@search list
@description "Albums ranked by plays, with track/artist counts and
artist chips. Filter by title with ?q (ilike)."
@watch
music_album (plays > ?min_plays:int=-1, limit ?limit:int=20, offset ?offset:int=0, order by ?sort(plays, title, created_on)="plays desc")
  xid
  title (ilike ?q:string="%")
  blurb
  plays
  cover
  _count
    tracks:tracks
    artists:artists
  ->artists
    xid
    name

@get detail
@description "One album by xid — tracks in order, artists and genres."
@watch
music_album (xid = ?xid:string)
  xid
  title
  blurb
  plays
  link
  cover
  ->tracks
    xid
    title
    release_on
    explicit
    length
  ->artists
    xid
    name
    country
  ->genres
    xid
    label

@sql-template stats
@description "Library headline numbers for the dashboard."
@namespace dashboard
@watch music_album, music_track, music_artist
@returns total_albums:int, total_tracks:int, total_plays:int?, total_artists:int
-- One CTE per entity, not scalar subqueries: RLS guards are injected per
-- CTE scope, so each aggregate is scoped to what the caller may read.
WITH al AS (SELECT count(*) AS n, sum({music_album.plays}) AS plays FROM {music_album}),
     tr AS (SELECT count(*) AS n FROM {music_track}),
     ar AS (SELECT count(*) AS n FROM {music_artist})
SELECT al.n     AS total_albums,
       tr.n     AS total_tracks,
       al.plays AS total_plays,
       ar.n     AS total_artists
FROM al, tr, ar

@batch overview: list stats
